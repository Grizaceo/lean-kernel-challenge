/-- Lane values are placed at their natural bit offsets; the cells are
disjoint, so `|||` and `+` agree here. Lane 7 covers cells 0..31 and
already carries the fixed first two cells. -/
def initLanes (seed : Nat) : Nat :=
  (lane0 seed <<< 224) |||
  (lane1 seed <<< 192) |||
  (lane2 seed <<< 160) |||
  (lane3 seed <<< 128) |||
  (lane4 seed <<< 96) |||
  (lane5 seed <<< 64) |||
  (lane6 seed <<< 32) |||
  (lane7 seed)

end InitAB2
